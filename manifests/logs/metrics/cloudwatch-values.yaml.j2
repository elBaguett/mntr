nameOverride: cloudwatch-top-agent-{{ node_region }}
clusterName: mntr
region: {{ node_region }}
k8sMode: K8S


containerLogs:
  enabled: true
  fluentBit:
    image:
      repository: aws-for-fluent-bit
      tag: latest
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 250m
        memory: 256Mi
    config:
      service: |
        [SERVICE]
            Daemon    Off
            Flush     1
            Log_Level info
            Parsers_File /fluent-bit/etc/parsers.conf
            Parsers_File /fluent-bit/etc/conf/custom_parsers.conf
            HTTP_Server   On
            HTTP_Listen   0.0.0.0
            HTTP_Port     2020
            Health_Check  On
            storage.path /var/fluent-bit/state

        [FILTER]
            Name                kubernetes
            Match               kube.*
            Kube_URL            https://kubernetes.default.svc:443
            tls.verify          Off
            Merge_Log           On
      customParsers: |
        [PARSER]
            Name cri
            Format cri

agent:
  nodeSelector:
    node-region: {{ node_region }}
  nameOverride: cloudwatch-agent-{{ node_region }}
  enabled: true
  serviceAccount:
    create: false
    name: cloudwatch-agent-sa-{{ node_region }}
  createClusterRole: false
  createRole: false
  mode: daemonset
  image:
    repository: cloudwatch-agent
    tag: latest
  customConfig:
    receivers:
      awscontainerinsightreceiver:
        insecure_skip_verify: true
        endpoint: {{ kubelet_endpoint }}
        add_full_pod_name_metric_label: true
        add_container_name_metric_label: true
    exporters:
      awsemf:
        region: {{ node_region }}
        log_group_name: "/aws/containerinsights/mntr/performance"
        log_stream_name: {{ node_name }}
    service:
      pipelines:
        metrics:
          receivers: [awscontainerinsightreceiver]
          exporters: [awsemf]

  extraVolumes:
    - name: kubelet-ca
      hostPath:
        path: /var/lib/kubelet/pki/ca.crt
        type: File
  extraVolumeMounts:
    - name: kubelet-ca
      mountPath: /usr/local/share/ca-certificates/kubelet-ca.crt
      subPath: ca.crt
      readOnly: true
  initContainers:
    - name: update-ca
      image: ubuntu:24.04
      command: ["/bin/sh", "-c", "cp /usr/local/share/ca-certificates/kubelet-ca.crt /usr/local/share/ca-certificates/kubelet-ca.crt && update-ca-certificates"]
      volumeMounts:
        - name: kubelet-ca
          mountPath: /usr/local/share/ca-certificates/kubelet-ca.crt
          subPath: ca.crt
          readOnly: true

  resources:
    requests:
      memory: 128Mi
      cpu: 250m
    limits:
      memory: 512Mi
      cpu: 500m

kubeletConfig:
  insecureSkipVerify: true

prometheus:
  enabled: false
dcgmExporter:
  enabled: false
neuronMonitor:
  enabled: false